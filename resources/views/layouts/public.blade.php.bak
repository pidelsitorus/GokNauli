    <style>
        :root {
            --primary: #26372a;
            --primary-light: #31563a;
            --primary-dark: #1b281e;

            --accent: #f2e5c5;

            --background: #f7f5ef;
            --surface: #ffffff;

            --text: #283029;
            --muted: #70776f;

            --border: #e5e8e1;

            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 20px;

            --shadow:
                0 8px 30px rgba(0, 0, 0, .07);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif;

            background: var(--background);
            color: var(--text);
            line-height: 1.5;
        }

        a {
            text-decoration: none;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        img {
            max-width: 100%;
        }

        .site-header {
            position: sticky;
            top: 0;
            z-index: 1000;

            background:
                rgba(38, 55, 42, .98);

            color: white;

            box-shadow:
                0 3px 18px rgba(0,0,0,.12);
        }

        .header-inner {
            width: 90%;
            max-width: 1400px;

            margin: auto;

            min-height: 74px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            gap: 25px;
        }

        .site-brand {
            color: white;

            font-size: 24px;
            font-weight: 800;

            letter-spacing: -.5px;

            white-space: nowrap;
        }

        .brand-subtitle {
            display: block;

            margin-top: 1px;

            color: #cfd8cc;

            font-size: 10px;
            font-weight: normal;

            letter-spacing: 1.3px;

            text-transform: uppercase;
        }

        .site-nav {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .site-nav a {
            position: relative;

            color: #eef2ec;

            padding: 10px 12px;

            border-radius: 8px;

            font-size: 14px;

            transition:
                background .2s,
                color .2s;
        }

        .site-nav a:hover {
            background:
                rgba(255,255,255,.09);

            color: white;
        }

        .site-nav a.active {
            background:
                rgba(242,229,197,.14);

            color: var(--accent);
        }

        .cart-link {
            display: inline-flex !important;
            align-items: center;
            gap: 7px;
        }

        .cart-badge {
            min-width: 20px;
            height: 20px;

            padding: 0 6px;

            border-radius: 20px;

            display: inline-flex;
            justify-content: center;
            align-items: center;

            background: var(--accent);
            color: var(--primary);

            font-size: 11px;
            font-weight: bold;
        }

        .menu-toggle {
            display: none;

            width: 42px;
            height: 42px;

            border: 1px solid
                rgba(255,255,255,.18);

            border-radius: 9px;

            background:
                rgba(255,255,255,.06);

            color: white;

            cursor: pointer;

            font-size: 22px;
        }

        .btn {
            display: inline-block;

            padding: 13px 20px;

            border-radius: var(--radius-sm);

            font-weight: 700;

            transition:
                transform .2s,
                background .2s;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: var(--primary-light);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary);
        }

        .btn-light {
            background: var(--accent);
            color: var(--primary);
        }

        .site-footer {
            background: var(--primary-dark);
            color: #d6ddd4;

            padding: 45px 5%;
        }

        .footer-inner {
            width: 90%;
            max-width: 1400px;

            margin: auto;

            display: grid;
            grid-template-columns:
                1.4fr
                1fr
                1fr;

            gap: 40px;
        }

        .footer-brand {
            font-size: 22px;
            font-weight: bold;

            color: white;

            margin-bottom: 10px;
        }

        .footer-description {
            max-width: 420px;

            color: #acb7a9;

            line-height: 1.7;

            font-size: 14px;
        }

        .footer-title {
            color: white;

            font-weight: bold;

            margin-bottom: 13px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .footer-links a {
            color: #bdc8ba;
            font-size: 14px;
        }

        .footer-links a:hover {
            color: white;
        }

        .footer-bottom {
            width: 90%;
            max-width: 1400px;

            margin: 35px auto 0;

            padding-top: 22px;

            border-top:
                1px solid rgba(255,255,255,.10);

            color: #929d90;

            font-size: 13px;

            display: flex;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
        }

        @media (max-width: 900px) {

            .header-inner {
                min-height: 68px;
            }

            .menu-toggle {
                display: block;
            }

            .site-nav {
                position: absolute;

                top: 68px;
                left: 0;
                right: 0;

                display: none;
                flex-direction: column;
                align-items: stretch;

                gap: 4px;

                padding: 15px 5% 20px;

                background: var(--primary);

                box-shadow:
                    0 10px 20px rgba(0,0,0,.13);
            }

            .site-nav.open {
                display: flex;
            }

            .site-nav a {
                width: 100%;
                padding: 12px 14px;
            }

            .footer-inner {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 600px) {

            .header-inner {
                width: 92%;
            }

            .site-brand {
                font-size: 21px;
            }

            .footer-inner {
                width: 92%;
                grid-template-columns: 1fr;
            }

            .footer-bottom {
                width: 92%;
                flex-direction: column;
            }
        }
    </style>

    @yield('styles')

</head>


